<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Remove /public from manually entered or previously shared URLs.
    # THE_REQUEST prevents this redirect from firing for the internal rewrite below.
    RewriteCond %{THE_REQUEST} \s/+public(?:[/?\s]) [NC]
    RewriteRule ^public(?:/(.*))?$ /$1 [R=301,L,NE]

    # Keep project files private and internally serve every request from /public.
    RewriteRule ^public(?:/.*)?$ - [L]
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<IfModule !mod_rewrite.c>
    Options -Indexes
</IfModule>
